@prefix ex: <urn:fixture:ontology:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:validationReport a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [
        a sh:ValidationResult ;
        sh:focusNode ex:conceptWithoutLabel ;
        sh:resultSeverity sh:Violation ;
        sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
        sh:resultPath skos:prefLabel ;
        sh:resultMessage "Synthetic fixture: a preferred label is missing."@en ;
        sh:sourceShape ex:PreferredLabelShape
    ] .
